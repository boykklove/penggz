# --------------------------
# OKX API 凭据
# --------------------------
OKX_API_KEY=your_api_key
OKX_API_SECRET=your_api_secret
OKX_API_PASSPHRASE=your_api_passphrase

# true=模拟盘, false=实盘（生产请先模拟盘验证）
OKX_SIMULATED=true
OKX_BASE_URL=https://www.okx.com

# --------------------------
# 交易执行配置
# --------------------------
INST_ID=BTC-USDT-SWAP
TD_MODE=cross
TARGET_POSITION=flat
ORDER_SIZE=1

# 风控：必须显式打开才会下单；默认 DRY-RUN
ENABLE_TRADING=false
MIN_USDT_EQUITY=100
MAX_SINGLE_ORDER_SIZE=5
MAX_DRAWDOWN_PCT=20
COOLDOWN_SEC=20

# 止盈止损（百分比，0表示不挂）
TP_PCT=0
SL_PCT=0

# 运行模式
LOOP_ENABLED=true
LOOP_INTERVAL_SEC=15
LOG_LEVEL=INFO

# run / healthcheck
MODE=run
